<Window x:Class="DoObejrzenia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoObejrzenia"
        mc:Ignorable="d"
       Title="Moja Lista do Obejrzenia" Height="450" Width="600">

   
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Szukaj (Tytuł/Gatunek):" VerticalAlignment="Center"/>
            <TextBox Width="200" Height="25" VerticalAlignment="Center" 
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <Button DockPanel.Dock="Bottom" Content="Usuń zaznaczony film" Height="30" Margin="0,10,0,0"
                        Command="{Binding DeleteMovieCommand}"/>
                <ListBox ItemsSource="{Binding MoviesView}" 
                         SelectedItem="{Binding SelectedMovie}"/>
            </DockPanel>

            
            <StackPanel Grid.Column="1">
                <TextBlock Text="Dodaj nowy film" FontWeight="Bold" Margin="0,0,0,10"/>

                <Label Content="Tytuł:"/>
                <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                <Label Content="Gatunek:"/>
                <TextBox Text="{Binding NewGenre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                <Label Content="Rok produkcji:"/>
                <TextBox Text="{Binding NewYear, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                <Button Content="Dodaj do listy" Height="30" 
                        Command="{Binding AddMovieCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window> 
